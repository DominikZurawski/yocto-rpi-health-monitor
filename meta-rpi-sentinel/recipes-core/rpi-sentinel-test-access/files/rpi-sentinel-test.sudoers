# Pozwól wywołać awarie wyłącznie w monitorze i przywrócić go po próbie.
developer ALL=(root) NOPASSWD: NOSETENV: @SYSTEMCTL@ stop rpi-sentinel.service, \
    @SYSTEMCTL@ start rpi-sentinel.service, \
    @SYSTEMCTL@ restart rpi-sentinel.service, \
    @SYSTEMCTL@ kill --kill-whom=main --signal=SIGKILL rpi-sentinel.service, \
    @SYSTEMCTL@ kill --kill-whom=main --signal=SIGSTOP rpi-sentinel.service, \
    @SYSTEMCTL@ reset-failed rpi-sentinel.service, \
    @SYSTEMCTL@ reboot
